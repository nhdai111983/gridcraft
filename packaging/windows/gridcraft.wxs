<?xml version="1.0" encoding="utf-8"?>
<!--
  Nexus Sheets MSI (NexusOffices, by Sonnytech; based on GridCraft). WiX Toolset v5:
  `dotnet tool install -g wix`. Built by package.ps1:

    wix build gridcraft.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files\Nexus Sheets, a Start Menu shortcut, an optional desktop
  shortcut, App Paths (Win+R `nexus-sheets`), and Nexus Sheets offered under "Open with" (and in
  Settings > Default apps) for .xlsx, .xlsm, .csv and .tsv, without taking over the user's default
  app for them.

  UpgradeCode and the component GUID below belong to Nexus Sheets alone (generated 2026-10-16;
  never change them, or upgrades install side by side). Never copy them from (or into) upstream
  GridCraft or a sibling app: Windows Installer treats every package sharing an UpgradeCode as one
  product and would remove the other app. Registry keys, ProgIds and the install folder are
  Nexus Sheets' own too, so it installs and uninstalls next to GridCraft without touching it.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Nexus Sheets"
      Manufacturer="Sonnytech"
      Version="$(var.Version)"
      UpgradeCode="AD43085E-E0C6-4FBD-A8FF-DA99DAC6F718"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Nexus Sheets spreadsheet" Manufacturer="Sonnytech" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Nexus Sheets is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="GridcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="GridcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/nhdai111983/gridcraft" />

    <!-- An explicit command-line value wins. Otherwise retain the previous installation's
         choice, defaulting to off for a fresh install. Run only in the first sequence so the
         execute sequence cannot reload the old choice after the user unchecks the box. -->
    <Property Id="DESKTOPSHORTCUT" Secure="yes" />
    <Property Id="SAVEDDESKTOPSHORTCUT" Secure="yes">
      <RegistrySearch Id="FindDesktopShortcutPreference" Root="HKLM"
          Key="Software\Sonnytech\Nexus Sheets\Installer" Name="DesktopShortcut" Type="raw" />
    </Property>
    <SetProperty Id="DESKTOPSHORTCUT" Action="LoadDesktopShortcutPreference" Value="1"
        After="AppSearch" Sequence="first"
        Condition="NOT DESKTOPSHORTCUT AND SAVEDDESKTOPSHORTCUT = &quot;1&quot;" />
    <SetProperty Id="DESKTOPSHORTCUT" Action="DefaultDesktopShortcut" Value="0"
        After="LoadDesktopShortcutPreference" Sequence="first" Condition="NOT DESKTOPSHORTCUT" />
    <SetProperty Id="DesktopShortcutChoice" Value="1" After="DefaultDesktopShortcut"
        Sequence="ui" Condition="DESKTOPSHORTCUT = &quot;1&quot;" />

    <Property Id="DefaultUIFont" Value="GridcraftUIFont" />
    <Property Id="ErrorDialog" Value="GridcraftErrorDlg" />
    <EnsureTable Id="ListBox" />
    <UI>
      <TextStyle Id="GridcraftUIFont" FaceName="Segoe UI" Size="9" />
      <Dialog Id="DesktopShortcutDlg" Width="320" Height="150" Title="Nexus Sheets Setup" NoMinimize="yes">
        <Control Id="Heading" Type="Text" X="15" Y="15" Width="290" Height="20" Text="Install Nexus Sheets" />
        <Control Id="Description" Type="Text" X="15" Y="40" Width="290" Height="28"
            Text="Install Nexus Sheets for everyone who uses this computer." />
        <Control Id="DesktopShortcutCheckbox" Type="CheckBox" X="15" Y="76" Width="290" Height="18"
            Property="DesktopShortcutChoice" CheckBoxValue="1" Text="Create a &amp;desktop shortcut" />
        <Control Id="Install" Type="PushButton" X="165" Y="118" Width="65" Height="20"
            Default="yes" ElevationShield="yes" Text="&amp;Install">
          <!-- An unchecked checkbox clears its property. Publish an explicit zero so the
               elevated execute sequence receives an unambiguous opt-out. -->
          <Publish Property="DESKTOPSHORTCUT" Value="1" Condition="DesktopShortcutChoice" />
          <Publish Property="DESKTOPSHORTCUT" Value="0" Condition="NOT DesktopShortcutChoice" />
          <Publish Event="EndDialog" Value="Return" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="240" Y="118" Width="65" Height="20" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>

      <!-- Windows Installer requires these support dialogs for authored full UI (ICE20).
           They contain only installer messages and standard response controls. -->
      <Dialog Id="GridcraftErrorDlg" Width="320" Height="120" Title="Nexus Sheets Setup" ErrorDialog="yes" NoMinimize="yes">
        <Control Id="ErrorText" Type="Text" X="15" Y="15" Width="290" Height="65" TabSkip="no" />
        <Control Id="A" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="Abort" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorAbort" />
        </Control>
        <Control Id="C" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="Cancel" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorCancel" />
        </Control>
        <Control Id="I" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="Ignore" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorIgnore" />
        </Control>
        <Control Id="N" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="No" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorNo" />
        </Control>
        <Control Id="O" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="OK" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorOk" />
        </Control>
        <Control Id="R" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="Retry" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorRetry" />
        </Control>
        <Control Id="Y" Type="PushButton" X="15" Y="90" Width="65" Height="20" Text="Yes" TabSkip="yes">
          <Publish Event="EndDialog" Value="ErrorYes" />
        </Control>
      </Dialog>
      <Dialog Id="FilesInUse" Width="320" Height="190" Title="Nexus Sheets Setup" NoMinimize="yes">
        <Control Id="Description" Type="Text" X="15" Y="15" Width="290" Height="35"
            Text="Close the applications listed below, then choose Retry. Ignore may require a restart." />
        <Control Id="Files" Type="ListBox" X="15" Y="55" Width="290" Height="85" Property="FileInUseProcess" />
        <Control Id="Retry" Type="PushButton" X="95" Y="155" Width="65" Height="20" Default="yes" Text="Retry">
          <Publish Event="EndDialog" Value="Retry" />
        </Control>
        <Control Id="Ignore" Type="PushButton" X="167" Y="155" Width="65" Height="20" Text="Ignore">
          <Publish Event="EndDialog" Value="Ignore" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="240" Y="155" Width="65" Height="20" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit" />
        </Control>
      </Dialog>
      <Dialog Id="SetupCompleteDlg" Width="320" Height="110" Title="Nexus Sheets Setup" NoMinimize="yes">
        <Control Id="Message" Type="Text" X="15" Y="20" Width="290" Height="35" Text="Nexus Sheets setup completed." />
        <Control Id="Close" Type="PushButton" X="240" Y="75" Width="65" Height="20" Default="yes" Cancel="yes" Text="Close">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>
      <Dialog Id="SetupCanceledDlg" Width="320" Height="110" Title="Nexus Sheets Setup" NoMinimize="yes">
        <Control Id="Message" Type="Text" X="15" Y="20" Width="290" Height="35" Text="Nexus Sheets setup was canceled." />
        <Control Id="Close" Type="PushButton" X="240" Y="75" Width="65" Height="20" Default="yes" Cancel="yes" Text="Close">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>
      <Dialog Id="SetupFailedDlg" Width="320" Height="110" Title="Nexus Sheets Setup" NoMinimize="yes">
        <Control Id="Message" Type="Text" X="15" Y="20" Width="290" Height="35" Text="Nexus Sheets setup could not finish. See the installer message or log for details." />
        <Control Id="Close" Type="PushButton" X="240" Y="75" Width="65" Height="20" Default="yes" Cancel="yes" Text="Close">
          <Publish Event="EndDialog" Value="Return" />
        </Control>
      </Dialog>
    </UI>
    <InstallUISequence>
      <!-- Component conditions must see the choice before costing. Do not show the choice
           during basic/silent installs, repair or uninstall. -->
      <Show Dialog="DesktopShortcutDlg" Before="CostInitialize" Condition="NOT Installed AND NOT REMOVE AND UILevel = 5" />
      <Show Dialog="SetupCompleteDlg" OnExit="success" Condition="UILevel = 5" />
      <Show Dialog="SetupCanceledDlg" OnExit="cancel" Condition="UILevel = 5" />
      <Show Dialog="SetupFailedDlg" OnExit="error" Condition="UILevel = 5" />
    </InstallUISequence>
    <AdminUISequence>
      <Show Dialog="SetupCompleteDlg" OnExit="success" Condition="UILevel = 5" />
      <Show Dialog="SetupCanceledDlg" OnExit="cancel" Condition="UILevel = 5" />
      <Show Dialog="SetupFailedDlg" OnExit="error" Condition="UILevel = 5" />
    </AdminUISequence>

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Nexus Sheets" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />
    <StandardDirectory Id="DesktopFolder" />

    <Feature Id="Main" Title="Nexus Sheets" Level="1">
      <ComponentGroupRef Id="GridcraftFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="GridcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="GridcraftApp" Guid="B077AEA1-B862-4956-B495-84E7BBB90C49">
        <File Id="GridcraftExe" Source="$(var.BinDir)\gridcraft.exe" Name="nexus-sheets.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Nexus Sheets"
              Description="Nexus Sheets spreadsheet" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="GridcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\nexus-sheets.exe" Value="[#GridcraftExe]" Type="string" />

        <!-- ProgIds: how Explorer opens a file with Nexus Sheets. Nothing here sets HKCR\.<ext>'s
             default value, so the user's current default app is left alone. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\Sonnytech.NexusSheets.Workbook" Value="Nexus Sheets Workbook" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Sonnytech.NexusSheets.Workbook\DefaultIcon" Value="&quot;[#GridcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Sonnytech.NexusSheets.Workbook\shell\open\command" Value="&quot;[#GridcraftExe]&quot; &quot;%1&quot;" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Sonnytech.NexusSheets.TextData" Value="Nexus Sheets Text Data" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Sonnytech.NexusSheets.TextData\DefaultIcon" Value="&quot;[#GridcraftExe]&quot;,0" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\Sonnytech.NexusSheets.TextData\shell\open\command" Value="&quot;[#GridcraftExe]&quot; &quot;%1&quot;" Type="string" />

        <!-- "Open with": Windows reads only the value names under OpenWithProgids; the data is
             ignored (WiX rejects an empty Value, so it repeats the ProgId). -->
        <RegistryValue Root="HKLM" Key="Software\Classes\.xlsx\OpenWithProgids" Name="Sonnytech.NexusSheets.Workbook" Value="Sonnytech.NexusSheets.Workbook" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.xlsm\OpenWithProgids" Name="Sonnytech.NexusSheets.Workbook" Value="Sonnytech.NexusSheets.Workbook" Type="string" />
        <!-- .xlsb and .ods are imported (data only) into a new workbook that saves as .xlsx. -->
        <RegistryValue Root="HKLM" Key="Software\Classes\.xlsb\OpenWithProgids" Name="Sonnytech.NexusSheets.Workbook" Value="Sonnytech.NexusSheets.Workbook" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.ods\OpenWithProgids" Name="Sonnytech.NexusSheets.Workbook" Value="Sonnytech.NexusSheets.Workbook" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.csv\OpenWithProgids" Name="Sonnytech.NexusSheets.TextData" Value="Sonnytech.NexusSheets.TextData" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Classes\.tsv\OpenWithProgids" Name="Sonnytech.NexusSheets.TextData" Value="Sonnytech.NexusSheets.TextData" Type="string" />

        <!-- Settings > Default apps: lets the user pick Nexus Sheets for these types. -->
        <RegistryValue Root="HKLM" Key="Software\Sonnytech\Nexus Sheets\Capabilities" Name="ApplicationName" Value="Nexus Sheets" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sonnytech\Nexus Sheets\Capabilities" Name="ApplicationDescription" Value="Open-source spreadsheet for .xlsx, CSV and TSV files" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sonnytech\Nexus Sheets\Capabilities\FileAssociations" Name=".xlsx" Value="Sonnytech.NexusSheets.Workbook" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sonnytech\Nexus Sheets\Capabilities\FileAssociations" Name=".xlsm" Value="Sonnytech.NexusSheets.Workbook" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sonnytech\Nexus Sheets\Capabilities\FileAssociations" Name=".csv" Value="Sonnytech.NexusSheets.TextData" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Sonnytech\Nexus Sheets\Capabilities\FileAssociations" Name=".tsv" Value="Sonnytech.NexusSheets.TextData" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\RegisteredApplications" Name="NexusSheets" Value="Software\Sonnytech\Nexus Sheets\Capabilities" Type="string" />
      </Component>

      <Component Id="GridcraftCli">
        <File Id="GridcraftCliExe" Source="$(var.BinDir)\gridcraft-cli.exe" Name="nexus-sheets-cli.exe" KeyPath="yes" />
      </Component>
      <!-- NexusOffices: the licences, NOTICE (Apache-2.0 4(d)) and ATTRIBUTION.md, staged by
           package.ps1, are installed beside the binaries. Auto GUIDs, like the CLI component. -->
      <Component Id="GridcraftMitLicense">
        <File Id="GridcraftMitLicenseFile" Source="$(var.BinDir)\LICENSE-MIT" KeyPath="yes" />
      </Component>
      <Component Id="GridcraftApacheLicense">
        <File Id="GridcraftApacheLicenseFile" Source="$(var.BinDir)\LICENSE-APACHE" KeyPath="yes" />
      </Component>
      <Component Id="GridcraftNotice">
        <File Id="GridcraftNoticeFile" Source="$(var.BinDir)\NOTICE" KeyPath="yes" />
      </Component>
      <Component Id="GridcraftAttribution">
        <File Id="GridcraftAttributionFile" Source="$(var.BinDir)\ATTRIBUTION.md" KeyPath="yes" />
      </Component>

      <!-- Persist both on and off, independently of the optional shortcut. AppSearch reads
           this before MajorUpgrade removes the previous product. -->
      <Component Id="DesktopShortcutPreference">
        <RegistryValue Root="HKLM" Key="Software\Sonnytech\Nexus Sheets\Installer" Name="DesktopShortcut"
            Value="[DESKTOPSHORTCUT]" Type="string" KeyPath="yes" />
      </Component>
      <Component Id="DesktopShortcutComponent" Directory="DesktopFolder" Condition="DESKTOPSHORTCUT = &quot;1&quot;">
        <Shortcut Id="DesktopShortcut" Name="Nexus Sheets" Description="Nexus Sheets spreadsheet"
            Target="[#GridcraftExe]" WorkingDirectory="INSTALLFOLDER" Icon="GridcraftIcon.ico" IconIndex="0" />
        <!-- HKMU resolves to HKLM for this per-machine package, so another account can
             uninstall the marker too. MSI root -1 also satisfies ICE43 for this shortcut. -->
        <RegistryValue Root="HKMU" Key="Software\Sonnytech\Nexus Sheets\Installer" Name="DesktopShortcutComponent"
            Value="1" Type="integer" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
